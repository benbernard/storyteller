# Copy to .env. Run node scripts/setup.mjs to create private state and passwords.
LISTENER_PUBLIC_URL=http://localhost:8080
LISTENER_USERNAME=listener
LISTENER_BIND=127.0.0.1
LISTENER_PORT=8080
# Optional local worker: choose a model available in your own Codex account.
AUDIOBOOK_ANALYSIS_MODEL=choose-your-analysis-model
# Paid CLI only; leave blank for the demo.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
