FROM mcr.microsoft.com/playwright:v1.63.0-noble
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
COPY --from=node:22-alpine /usr/local/lib/node_modules/corepack /opt/corepack
RUN node /opt/corepack/dist/corepack.js enable --install-directory /usr/local/bin && node /opt/corepack/dist/corepack.js prepare pnpm@10.33.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=homelab-pnpm-10,target=/pnpm/store,sharing=locked pnpm install --store-dir=/pnpm/store --package-import-method=copy --frozen-lockfile
COPY listener-web ./listener-web
COPY test-listener.mjs test-design-parity.mjs ./
COPY test-fixtures ./test-fixtures
CMD ["pnpm", "run", "test:browser"]
